# 复制为 .env；切勿公开上传 / Git commit（密钥绝不能发到聊天）
MINIMAX_API_KEY=
# 国内 https://api.minimax.cn | 国际 https://api.minimax.io
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_SPEECH_MODEL=speech-2.8-turbo
HEYGEN_API_KEY=
# 只需创建一次，后续复用
MINIMAX_VOICE_ID=
HEYGEN_AVATAR_ID=

# 仅用于 AI 自动写文案：OpenAI-compatible Chat Completions（也可不填，使用 MiniMax Key）
# LLM_API_KEY=
# LLM_API_URL=https://api.minimax.cn/v1/chat/completions
LLM_MODEL=MiniMax-M3

# 可选：替换为本机合法字体文件路径（不分发字体文件）
# VIDEO_FONT_PATH=/System/Library/Fonts/PingFang.ttc
VIDEO_CRF=23
VIDEO_PRESET=veryfast
